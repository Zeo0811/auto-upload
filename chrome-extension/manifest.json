{
  "manifest_version": 3,
  "name": "Auto Upload",
  "version": "2.0.0",
  "description": "自动上传视频到多平台创作中心（小红书、抖音、视频号等）",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "scripting",
    "activeTab",
    "debugger",
    "webNavigation",
    "cookies"
  ],
  "host_permissions": [
    "https://creator.xiaohongshu.com/*",
    "https://creator.douyin.com/*",
    "https://*.douyin.com/*",
    "https://channels.weixin.qq.com/*",
    "http://127.0.0.1:7790/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://creator.xiaohongshu.com/*",
        "https://creator.douyin.com/*",
        "https://*.douyin.com/*",
        "https://channels.weixin.qq.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
